{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "elliot14a.work",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "vars": {
    "PORTFOLIO_OPENAI_BASE_URL": "https://openrouter.ai/api/v1",
    "PORTFOLIO_OPENAI_MODEL": "deepseek/deepseek-v4-flash-0731",
    "PORTFOLIO_OPENAI_EXTRA_BODY": "{\"reasoning\":{\"enabled\":false},\"provider\":{\"order\":[\"DeepInfra\"],\"allow_fallbacks\":true}}"
  },
  "kv_namespaces": [
    {
      "binding": "CHAT",
      "id": "46eb82aaed3c4074a4721d47e320e008",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
