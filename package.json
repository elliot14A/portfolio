{
  "name": "portfolio-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint",
    "typecheck": "bun --filter \"*\" typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "build:content": "bun run scripts/buildContent.ts",
    "build:client": "node scripts/buildClient.ts",
    "build:worker": "node scripts/buildWorker.ts",
    "build": "bun run build:content && bun run build:client && bun run build:worker"
  },
  "dependencies": {
    "@effect/ai-openai": "4.0.0-rc.115",
    "@effect/sql-d1": "4.0.0-rc.115",
    "@vanilla-extract/css": "1.21.3",
    "effect": "4.0.0-rc.115",
    "preact": "10.29.8",
    "preact-render-to-string": "6.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "1.4.0",
    "@types/node": "26.1.1",
    "@vanilla-extract/esbuild-plugin": "2.3.22",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
